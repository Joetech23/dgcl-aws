# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables.
# Leave the Supabase values empty to run the site in preview mode (browser-only data).

# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google Search Console > Add property > URL prefix > "HTML tag":
# paste only the content value. On GitHub, add it as a repository variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional. The public address, used in the sitemap and share cards.
# Default: https://lth.dgclgroup.com
# NEXT_PUBLIC_SITE_URL=https://lth.dgclgroup.com

# Preview mode only: accounts with these emails see the admin panel.
# With Supabase, admins are set in the database (see supabase/migrations/0001_lms.sql).
NEXT_PUBLIC_ADMIN_EMAILS=admin@dgclgroup.com

# Enquiry emails (alert to DGCL, receipt to the learner), sent through Resend.
# Server only: never prefix these with NEXT_PUBLIC. On cPanel, add them under
# Setup Node.js App > Environment variables, then restart the app.
# Resend > API Keys. Leave empty and the site simply sends no enquiry emails.
RESEND_API_KEY=
# Optional. Defaults shown.
# EMAIL_FROM=DGCL Digital Cloud Academy <no-reply@freelearning.dgclgroup.com>
# SALES_EMAIL=info@dgclgroup.com
# SITE_URL=https://freelearning.dgclgroup.com

# ---------------------------------------------------------------------------
# Payments (Stripe). Server only: never prefix these with NEXT_PUBLIC, never
# commit real values. On cPanel, add them under Setup Node.js App >
# Environment variables, then restart the app. Full steps: docs/payments.md
#
# Without all three, nothing can be bought online: priced modules show a
# "not switched on yet" message and instructor-led enquiries are still sent.
# ---------------------------------------------------------------------------
# Stripe > Developers > API keys > Secret key. Use the sk_test_ key first.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=
# Supabase > Project settings > API > service_role. Lets the server record a
# payment Stripe has confirmed. It bypasses every database rule: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
