# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables.
# Leave the Supabase values empty to run the site in preview mode (browser-only data).

# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preview mode only: accounts with these emails see the admin panel.
# With Supabase, admins are set in the database (see supabase/migrations/0001_lms.sql).
NEXT_PUBLIC_ADMIN_EMAILS=admin@dgclgroup.com

# Enquiry emails (alert to DGCL, receipt to the learner), sent through Resend.
# Server only: never prefix these with NEXT_PUBLIC. On cPanel, add them under
# Setup Node.js App > Environment variables, then restart the app.
# Resend > API Keys. Leave empty and the site simply sends no enquiry emails.
RESEND_API_KEY=
# Optional. Defaults shown.
# EMAIL_FROM=DGCL Digital Cloud Academy <no-reply@freelearning.dgclgroup.com>
# SALES_EMAIL=info@dgclgroup.com
# SITE_URL=https://freelearning.dgclgroup.com
